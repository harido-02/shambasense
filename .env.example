# Copy to .env and fill in. Never commit .env.

# SQLite by default (data/shambasense.db). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://shamba:password@localhost:5432/shambasense
DATABASE_URL=

# Protects POST /api/admin/outlook (entering KMD seasonal outlooks).
ADMIN_TOKEN=

# Used by docker-compose for the PostgreSQL container.
POSTGRES_PASSWORD=

# 1 = never call external APIs; only cached responses are used.
SHAMBA_OFFLINE=0
